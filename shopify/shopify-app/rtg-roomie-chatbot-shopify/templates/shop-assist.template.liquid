{% liquid
  assign launcher_label = block.settings.launcher_label | default: 'Shopping Assistant'
  assign header_title = block.settings.header_title | default: 'Shopping Assistant'
  assign assistant_name = block.settings.assistant_name | default: 'Shopping Assistant'
  assign input_placeholder = block.settings.input_placeholder | default: 'Ask about products...'
  assign placement = block.settings.placement | default: 'bottom-right'
  assign accent = block.settings.accent | default: '#1f1f1f'
  assign accent_text = block.settings.accent_text | default: '#ffffff'
  assign bg_primary = block.settings.bg_primary | default: accent
  assign bg_primary_text = block.settings.bg_primary_text | default: accent_text
  assign bg_secondary = block.settings.bg_secondary | default: '#ece9e2'
  assign bg_secondary_text = block.settings.bg_secondary_text | default: '#1a1a1a'
  assign app_base_url = '__SHOP_ASSIST_APP_BASE_URL__'
%}

{% if app_base_url != blank %}
  <script
    src="{{ app_base_url }}/api/shopify/theme-embed?shop={{ shop.permanent_domain | url_encode }}&launcherLabel={{ launcher_label | url_encode }}&headerTitle={{ header_title | url_encode }}&assistantName={{ assistant_name | url_encode }}&inputPlaceholder={{ input_placeholder | url_encode }}&placement={{ placement | url_encode }}&accent={{ accent | url_encode }}&accentText={{ accent_text | url_encode }}&bgPrimary={{ bg_primary | url_encode }}&bgPrimaryText={{ bg_primary_text | url_encode }}&bgSecondary={{ bg_secondary | url_encode }}&bgSecondaryText={{ bg_secondary_text | url_encode }}"
    defer
    data-shop="{{ shop.permanent_domain | escape }}"
  ></script>
{% endif %}

{% schema %}
{
  "name": "Shop Assist",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "assistant_name",
      "label": "Assistant name",
      "default": "Shopping Assistant"
    },
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Launcher label",
      "default": "Shopping Assistant"
    },
    {
      "type": "text",
      "id": "header_title",
      "label": "Header title",
      "default": "Shopping Assistant"
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Input placeholder",
      "default": "Ask about products..."
    },
    {
      "type": "radio",
      "id": "placement",
      "label": "Widget position",
      "default": "bottom-right",
      "options": [
        {
          "value": "bottom-right",
          "label": "Bottom right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        }
      ]
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "accent_text",
      "label": "Accent text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_primary",
      "label": "Primary background",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "bg_primary_text",
      "label": "Primary text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bg_secondary",
      "label": "Secondary background",
      "default": "#ece9e2"
    },
    {
      "type": "color",
      "id": "bg_secondary_text",
      "label": "Secondary text color",
      "default": "#1a1a1a"
    }
  ]
}
{% endschema %}
